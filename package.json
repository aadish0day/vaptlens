{
  "name": "vaptlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Self-hosted VAPT analytics workbench",
  "types": "design/components/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tokens.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "tokens:dtcg": "node scripts/tokens-to-dtcg.mjs",
    "server": "node server/server.mjs",
    "test": "node scripts/selftest.mjs && node server/check.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "docx": "8.5.0",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.55.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "papaparse": "5.4.1",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.4.4",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.5.4",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.0"
  }
}
