# Copy to .env and fill in before the first `docker compose up`.
POSTGRES_DB=vaptlens
POSTGRES_USER=vaptlens
# required; generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Who can reach the app. Default: only this machine (http://localhost:8080).
# For teammates on your network: BIND_ADDR=0.0.0.0 and list the hostname/IP they'll use.
BIND_ADDR=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# 1 once the app is served over HTTPS (session cookie gets the Secure flag)
COOKIE_SECURE=0

# Only for running server/server.mjs outside Docker against your own Postgres; without it the server uses SQLite.
DATABASE_URL=
