POSTGRES_DB=vaptlens
POSTGRES_USER=vaptlens
# required; generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
# only for running server/server.mjs or check-postgres.mjs outside Docker against your own Postgres
# (the compose Postgres is not published to the host)
DATABASE_URL=
# without a token the API is unauthenticated; required before exposing the app (BIND_ADDR=0.0.0.0)
SYNC_TOKEN=
# host address for published ports; loopback by default
BIND_ADDR=127.0.0.1
